        "quantity": 1,
        "unitMonthlyUsd": 1.00,
        "pricingSource": "awsKms",
        "billedUnitsByScenario": {
          "initial": 1,
          "afterFirstBilledKmsRotation": 2,
          "afterSecondBilledKmsRotation": 3
