        "monthlyUsdByScenario": {
          "initial": 10.00,
          "afterFirstBilledKmsRotation": 10.00,
          "afterSecondBilledKmsRotation": 10.00
        }
      },
      {
        "id": "web-acl-rules",
        "description": "Five WebACL rule associations per edge stack",
        "quantity": 10,
        "unitMonthlyUsd": 1.00,
        "pricingSource": "awsWaf",
        "monthlyUsdByScenario": {
          "initial": 10.00,
          "afterFirstBilledKmsRotation": 10.00,
          "afterSecondBilledKmsRotation": 10.00
        }
      },
      {
        "id": "standard-cloudwatch-alarm-metrics",
        "description": "Standard-resolution CloudWatch alarm metrics",
        "quantity": 6,
        "unitMonthlyUsd": 0.10,
        "pricingSource": "awsCloudWatch",
        "monthlyUsdByScenario": {
          "initial": 0.60,
          "afterFirstBilledKmsRotation": 0.60,
          "afterSecondBilledKmsRotation": 0.60
        }
      },
      {
