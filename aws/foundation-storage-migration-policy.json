        "monthlyUsdByScenario": {
          "initial": 1.00,
          "afterFirstBilledKmsRotation": 2.00,
          "afterSecondBilledKmsRotation": 3.00
        }
      }
    ],
    "scenarios": [
      {
        "id": "initial",
        "expectedMonthlyUsd": 22.40
      },
      {
        "id": "afterFirstBilledKmsRotation",
        "expectedMonthlyUsd": 23.40
      },
      {
        "id": "afterSecondBilledKmsRotation",
        "expectedMonthlyUsd": 24.40
